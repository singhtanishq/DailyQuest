  "prompt": "Take a non-negative integer, sum its decimal digits, and repeat with the sum until only one digit remains. Print that final digit.",
  "instructions": [
    "Read one non-negative integer from input.",
    "Print the single digit that the process converges to."
  ],
  "constraints": [
