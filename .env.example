# =========================================================
# DailyQuest — local environment
#
# Copy to .env for local overrides. No secrets are ever
# required for local generation; publishing credentials are
# configured as GitHub Actions secrets only (see README).
# =========================================================

# Publication timezone used to resolve "today" (IANA name).
DAILYQUEST_TIMEZONE=Asia/Kolkata

# Base path where the site is served (GitHub Pages project site).
# Set to "/" for a user site or custom domain.
DAILYQUEST_BASE_PATH=/DailyQuest/

# Canonical site URL used for sitemap/SEO generation.
DAILYQUEST_SITE_URL=https://singhtanishq.github.io/DailyQuest/

# The following belong in GitHub Actions SECRETS, not in this file.
# They are listed here only to document their names.
# DAILYQUEST_COMMIT_NAME=Your Name
# DAILYQUEST_COMMIT_EMAIL=your-github-verified-email@example.com
# DAILYQUEST_PUSH_TOKEN=ghp_xxx (fine-grained PAT with Contents: read/write)